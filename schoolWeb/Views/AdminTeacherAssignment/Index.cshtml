@model List<schoolWeb.ViewModels.TeacherAssignment.TeacherAssignmentViewModel>

@*
    هذه الصفحة مسؤولة عن:
    - عرض جميع التكليفات التدريسية
    - البحث التلقائي عن تكليف
    - الانتقال لإضافة تكليف جديد
    - تعديل تكليف
    - حذف تكليف
*@

@{
    ViewData["Title"] = "إدارة التكليفات التدريسية";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>إدارة التكليفات التدريسية</h2>
    <p>من هنا يمكنك ربط المدرس بالمادة والصف والشعبة.</p>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    @if (TempData["Success"] != null)
    {
        <div class="success-message">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error-message">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="error-message">@ViewBag.Error</div>
    }

    <a asp-controller="AdminTeacherAssignment"
       asp-action="Create"
       class="btn-primary-custom"
       style="width:auto; padding:12px 24px; display:inline-block;">
        إضافة تكليف تدريسي جديد
    </a>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    <h3 style="margin-top:0;">البحث عن تكليف تدريسي</h3>

    <div class="form-group">
        <label>بحث باسم المدرس أو رقم المدرس أو المادة أو الصف أو الشعبة</label>
        <input id="assignmentSearchInput"
               class="form-control"
               placeholder="مثال: أحمد أو رياضيات أو الصف 1 أو A" />
    </div>

    <p id="searchResultText" style="margin-top:10px; color:#64748b;">
        يتم عرض جميع التكليفات.
    </p>
</div>

<div class="page-box">
    <h3 style="margin-top:0;">قائمة التكليفات التدريسية</h3>

    @if (Model != null && Model.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>م</th>
                    <th>المدرس</th>
                    <th>رقم المدرس</th>
                    <th>المادة</th>
                    <th>الصف</th>
                    <th>الشعبة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int counter = 1;
                }

                @foreach (var item in Model)
                {
                    <tr class="assignment-row"
                        data-search="@($"{item.TeacherName} {item.TeacherNumber} {item.SubjectName} {item.ClassRoomName} {item.SectionName}".ToLower())">
                        <td class="row-number">@counter</td>
                        <td>@item.TeacherName</td>
                        <td>@item.TeacherNumber</td>
                        <td>@item.SubjectName</td>
                        <td>@item.ClassRoomName</td>
                        <td>@item.SectionName</td>

                        <td class="actions-cell">
                            <a asp-controller="AdminTeacherAssignment"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-warning-custom">
                                تعديل
                            </a>

                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit"
                                        class="btn-danger-custom"
                                        onclick="return confirm('هل أنت متأكد من حذف هذا التكليف التدريسي؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>

                    counter++;
                }
            </tbody>
        </table>

        <p id="noResultsMessage" style="display:none; margin-top:15px;">
            لا توجد تكليفات مطابقة للبحث.
        </p>
    }
    else
    {
        <p>لا توجد تكليفات تدريسية مضافة حتى الآن.</p>
    }
</div>

@section Scripts {
    <script>
        /*
            بحث تلقائي عن التكليفات التدريسية
        */
        const searchInput = document.getElementById("assignmentSearchInput");
        const rows = document.querySelectorAll(".assignment-row");
        const noResultsMessage = document.getElementById("noResultsMessage");
        const searchResultText = document.getElementById("searchResultText");

        searchInput.addEventListener("input", function () {
            const searchValue = this.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(function (row) {
                const rowText = row.getAttribute("data-search");

                if (rowText.includes(searchValue)) {
                    row.style.display = "";
                    visibleCount++;

                    row.querySelector(".row-number").textContent = visibleCount;
                } else {
                    row.style.display = "none";
                }
            });

            noResultsMessage.style.display = visibleCount === 0 ? "block" : "none";

            searchResultText.textContent =
                searchValue === ""
                    ? "يتم عرض جميع التكليفات."
                    : "عدد النتائج المطابقة: " + visibleCount;
        });
    </script>
}