@model schoolWeb.Controllers.CreateSectionPageViewModel

@*
    هذه الصفحة مسؤولة عن:
    - عرض جميع الشعب
    - إضافة شعبة جديدة
    - حذف شعبة
    - الانتقال إلى تعديل الشعبة

    ملاحظة مهمة:
    عند الإرسال إلى Action باسم:
    CreateSection(CreateSectionViewModel model)

    يجب أن تكون أسماء الحقول:
    - Name
    - ClassRoomName

    لذلك في النموذج سنستخدم name مباشرة
    حتى يربطها الكنترولر بشكل صحيح
*@

@{
    ViewData["Title"] = "إدارة الشعب";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>إدارة الشعب</h2>
    <p>من هنا يمكنك عرض الشعب الدراسية وإضافة شعبة جديدة داخل صف معين.</p>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    <h3 style="margin-top:0;">إضافة شعبة جديدة</h3>

    @if (TempData["Success"] != null)
    {
        <div class="success-message">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error-message">@TempData["Error"]</div>
    }

    @*
    هذا النموذج يرسل البيانات إلى الكنترولر
    لذلك يجب أن تكون أسماء الحقول مطابقة تمامًا
    لخصائص CreateSectionViewModel
    *@
    <form asp-action="CreateSection" method="post">
        <div class="form-group">
            <label>اسم الشعبة</label>

            @* نستخدم name="Name" حتى تصل القيمة إلى model.Name *@
            <input name="Name" class="form-control" placeholder="مثال: A" />
        </div>

        <div class="form-group">
            <label>الصف</label>

            @* نستخدم name="ClassRoomName" حتى تصل القيمة إلى model.ClassRoomName *@
            <select name="ClassRoomName" class="form-control">
                <option value="">-- اختر الصف --</option>

                @foreach (var item in Model.CreateSection.ClassRooms)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
        </div>

        <button type="submit" class="btn-primary-custom" style="width:auto; padding:12px 24px; margin-top:12px;">
            إضافة الشعبة
        </button>
    </form>
</div>

<div class="page-box">
    <h3 style="margin-top:0;">قائمة الشعب</h3>

    @if (Model.Sections != null && Model.Sections.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>م</th>
                    <th>اسم الشعبة</th>
                    <th>اسم الصف</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int counter = 1;
                }

                @foreach (var item in Model.Sections)
                {
                    <tr>
                        <td>@counter</td>
                        <td>@item.SectionName</td>
                        <td>@item.ClassRoomName</td>
                        <td class="actions-cell">
                            <a asp-action="EditSection" asp-route-id="@item.Id" class="btn-warning-custom">
                                تعديل
                            </a>

                            <form asp-action="DeleteSection" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit"
                                        class="btn-danger-custom"
                                        onclick="return confirm('هل أنت متأكد من حذف هذه الشعبة؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>

                    counter++;
                }
            </tbody>
        </table>
    }
    else
    {
        <p>لا توجد شعب مضافة حتى الآن.</p>
    }
</div>