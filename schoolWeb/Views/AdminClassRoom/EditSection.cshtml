@model schoolWeb.ViewModels.UpdateSectionViewModel

@*
    هذه الصفحة مسؤولة عن تعديل بيانات الشعبة
*@

@{
    ViewData["Title"] = "تعديل الشعبة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>تعديل الشعبة</h2>
    <p>يمكنك من هنا تعديل اسم الشعبة والصف المرتبطة به.</p>
</div>

<div class="page-box">
    <form asp-action="EditSection" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Name">اسم الشعبة</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ClassRoomName">الصف</label>
            <select asp-for="ClassRoomName" asp-items="Model.ClassRooms" class="form-control">
                <option value="">-- اختر الصف --</option>
            </select>
            <span asp-validation-for="ClassRoomName" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-primary-custom" style="width:auto; padding:12px 24px; margin-top:12px;">
            حفظ التعديل
        </button>

        <a asp-action="Sections" class="btn-secondary-custom">رجوع</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}