@model List<schoolWeb.ViewModels.ClassRoomViewModel>

@*
    هذه الصفحة مسؤولة عن:
    - عرض جميع الصفوف
    - إضافة صف جديد
    - تعديل صف
    - حذف صف

    تم تعديلها بحيث:
    - لا نعرض Id الخاص بقاعدة البيانات
    - نعرض رقمًا تسلسليًا داخل الجدول
*@

@{
    ViewData["Title"] = "إدارة الصفوف";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>إدارة الصفوف</h2>
    <p>من هنا يمكنك عرض الصفوف الدراسية وإضافة صف جديد وتعديله أو حذفه.</p>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    <h3 style="margin-top:0;">إضافة صف جديد</h3>

    @* عرض رسالة نجاح عند نجاح العملية *@
    @if (TempData["Success"] != null)
    {
        <div class="success-message">@TempData["Success"]</div>
    }

    @* عرض رسالة خطأ عند فشل العملية *@
    @if (TempData["Error"] != null)
    {
        <div class="error-message">@TempData["Error"]</div>
    }

    @* نموذج إضافة صف جديد *@
    <form asp-action="CreateClassRoom" method="post">
        <div class="form-group">
            <label>اسم الصف</label>
            <input name="Name" class="form-control" placeholder="مثال: الصف 1" />
        </div>

        <button type="submit" class="btn-primary-custom" style="width:auto; padding:12px 24px; margin-top:12px;">
            إضافة الصف
        </button>
    </form>
</div>

<div class="page-box">
    <h3 style="margin-top:0;">قائمة الصفوف</h3>

    @if (Model != null && Model.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    @* رقم تسلسلي للعرض فقط وليس Id القاعدة *@
                    <th>م</th>

                    <th>اسم الصف</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @{
                    /*
                    هذا المتغير يستخدم لإظهار رقم تسلسلي داخل الجدول
                    بدل رقم Id القادم من قاعدة البيانات
                    */
                    int counter = 1;
                }

                @foreach (var item in Model)
                {
                    <tr>
                        @* عرض الرقم التسلسلي بدل Id *@
                        <td>@counter</td>

                        <td>@item.Name</td>

                        <td class="actions-cell">
                            @* الانتقال إلى صفحة تعديل الصف *@
                            <a asp-action="EditClassRoom" asp-route-id="@item.Id" class="btn-warning-custom">
                                تعديل
                            </a>

                            @* حذف الصف مع نافذة تأكيد قبل التنفيذ *@
                            <form asp-action="DeleteClassRoom" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit"
                                        class="btn-danger-custom"
                                        onclick="return confirm('هل أنت متأكد من حذف هذا الصف؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>

                    @* زيادة الرقم التسلسلي لكل صف جديد *@
                    counter++;
                }
            </tbody>
        </table>
    }
    else
    {
        <p>لا توجد صفوف مضافة حتى الآن.</p>
    }
</div>