@model List<schoolWeb.ViewModels.StudentViewModel>

@*
    هذه الصفحة مسؤولة عن:
    - عرض جميع الطلاب
    - البحث التلقائي عن طالب أثناء الكتابة
    - الانتقال لإضافة طالب
    - تعديل طالب
    - حذف طالب
*@

@{
    ViewData["Title"] = "إدارة الطلاب";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>إدارة الطلاب</h2>
    <p>من هنا يمكنك عرض الطلاب، البحث عن طالب، إضافة طالب جديد، تعديل بياناته، أو حذفه.</p>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    @if (TempData["Success"] != null)
    {
        <div class="success-message">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error-message">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="error-message">@ViewBag.Error</div>
    }

    <a asp-controller="AdminStudent"
       asp-action="Create"
       class="btn-primary-custom"
       style="width:auto; padding:12px 24px; display:inline-block;">
        إضافة طالب جديد
    </a>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    <h3 style="margin-top:0;">البحث عن طالب</h3>

    @*
    هذا البحث يعمل تلقائيًا من JavaScript
    بدون إرسال فورم وبدون إعادة تحميل الصفحة
    *@
    <div class="form-group">
        <label>بحث بالاسم أو رقم الطالب أو اسم المستخدم أو الصف أو الشعبة</label>
        <input id="studentSearchInput"
               class="form-control"
               placeholder="مثال: محمد أو 1001 أو student1 أو الصف 1 أو A" />
    </div>

    <p id="searchResultText" style="margin-top:10px; color:#64748b;">
        يتم عرض جميع الطلاب.
    </p>
</div>

<div class="page-box">
    <h3 style="margin-top:0;">قائمة الطلاب</h3>

    @if (Model != null && Model.Any())
    {
        <table class="custom-table" id="studentsTable">
            <thead>
                <tr>
                    <th>م</th>
                    <th>رقم الطالب</th>
                    <th>اسم الطالب</th>
                    <th>اسم المستخدم</th>
                    <th>الصف</th>
                    <th>الشعبة</th>
                    <th>ولي الأمر</th>
                    <th>جوال ولي الأمر</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int counter = 1;
                }

                @foreach (var item in Model)
                {
                    @*
            نضع data-search في كل صف
            حتى يستخدمه JavaScript للبحث التلقائي
            *@
                    <tr class="student-row"
                        data-search="@($"{item.StudentNumber} {item.FullName} {item.Username} {item.ClassRoomName} {item.SectionName} {item.ParentName} {item.ParentPhone}".ToLower())">
                        <td class="row-number">@counter</td>
                        <td>@item.StudentNumber</td>
                        <td>@item.FullName</td>
                        <td>@item.Username</td>
                        <td>@item.ClassRoomName</td>
                        <td>@item.SectionName</td>
                        <td>@item.ParentName</td>
                        <td>@item.ParentPhone</td>

                        <td class="actions-cell">
                            <a asp-controller="AdminStudent"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-warning-custom">
                                تعديل
                            </a>

                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit"
                                        class="btn-danger-custom"
                                        onclick="return confirm('هل أنت متأكد من حذف هذا الطالب؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>

                    counter++;
                }
            </tbody>
        </table>

        <p id="noResultsMessage" style="display:none; margin-top:15px;">
            لا يوجد طلاب مطابقون للبحث.
        </p>
    }
    else
    {
        <p>لا يوجد طلاب مضافون حتى الآن.</p>
    }
</div>

@section Scripts {
    <script>
        /*
            =====================================================
            بحث تلقائي عن الطلاب
            =====================================================

            هذا السكربت:
            - يراقب الكتابة داخل مربع البحث
            - يخفي الطلاب غير المطابقين
            - يظهر الطلاب المطابقين مباشرة
            - يعيد ترقيم الصفوف الظاهرة فقط
        */

        const searchInput = document.getElementById("studentSearchInput");
        const rows = document.querySelectorAll(".student-row");
        const noResultsMessage = document.getElementById("noResultsMessage");
        const searchResultText = document.getElementById("searchResultText");

        searchInput.addEventListener("input", function () {
            const searchValue = this.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(function (row) {
                const rowText = row.getAttribute("data-search");

                if (rowText.includes(searchValue)) {
                    row.style.display = "";
                    visibleCount++;

                    const rowNumberCell = row.querySelector(".row-number");
                    rowNumberCell.textContent = visibleCount;
                } else {
                    row.style.display = "none";
                }
            });

            if (visibleCount === 0) {
                noResultsMessage.style.display = "block";
            } else {
                noResultsMessage.style.display = "none";
            }

            if (searchValue === "") {
                searchResultText.textContent = "يتم عرض جميع الطلاب.";
            } else {
                searchResultText.textContent = "عدد النتائج المطابقة: " + visibleCount;
            }
        });
    </script>
}