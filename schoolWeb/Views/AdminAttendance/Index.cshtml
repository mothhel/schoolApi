@model List<schoolWeb.ViewModels.Attendance.AttendanceViewModel>

@*
    هذه الصفحة مسؤولة عن:
    - عرض جميع سجلات الحضور والغياب
    - البحث التلقائي
    - الانتقال لإضافة سجل جديد
    - تعديل سجل
    - حذف سجل
*@

@{
    ViewData["Title"] = "إدارة الحضور والغياب";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>إدارة الحضور والغياب</h2>
    <p>من هنا يمكنك عرض حضور وغياب الطلاب حسب الطالب والمادة والصف والشعبة.</p>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    @if (TempData["Success"] != null)
    {
        <div class="success-message">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error-message">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="error-message">@ViewBag.Error</div>
    }

    <a asp-controller="AdminAttendance"
       asp-action="Create"
       class="btn-primary-custom"
       style="width:auto; padding:12px 24px; display:inline-block;">
        إضافة حضور / غياب
    </a>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    <h3 style="margin-top:0;">البحث في السجلات</h3>

    <div class="form-group">
        <label>بحث باسم الطالب أو رقمه أو المادة أو الصف أو الشعبة أو الحالة</label>
        <input id="attendanceSearchInput"
               class="form-control"
               placeholder="مثال: محمد أو 2026001 أو رياضيات أو غائب" />
    </div>

    <p id="searchResultText" style="margin-top:10px; color:#64748b;">
        يتم عرض جميع سجلات الحضور والغياب.
    </p>
</div>

<div class="page-box">
    <h3 style="margin-top:0;">قائمة الحضور والغياب</h3>

    @if (Model != null && Model.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>م</th>
                    <th>الطالب</th>
                    <th>رقم الطالب</th>
                    <th>المادة</th>
                    <th>الصف</th>
                    <th>الشعبة</th>
                    <th>المدرس</th>
                    <th>التاريخ</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int counter = 1;
                }

                @foreach (var item in Model)
                {
                    <tr class="attendance-row"
                        data-search="@($"{item.StudentName} {item.StudentNumber} {item.SubjectName} {item.ClassRoomName} {item.SectionName} {item.TeacherName} {item.Status}".ToLower())">
                        <td class="row-number">@counter</td>
                        <td>@item.StudentName</td>
                        <td>@item.StudentNumber</td>
                        <td>@item.SubjectName</td>
                        <td>@item.ClassRoomName</td>
                        <td>@item.SectionName</td>
                        <td>@item.TeacherName</td>
                        <td>@item.AttendanceDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.Status</td>

                        <td class="actions-cell">
                            <a asp-controller="AdminAttendance"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-warning-custom">
                                تعديل
                            </a>

                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit"
                                        class="btn-danger-custom"
                                        onclick="return confirm('هل أنت متأكد من حذف هذا السجل؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>

                    counter++;
                }
            </tbody>
        </table>

        <p id="noResultsMessage" style="display:none; margin-top:15px;">
            لا توجد سجلات مطابقة للبحث.
        </p>
    }
    else
    {
        <p>لا توجد سجلات حضور أو غياب مضافة حتى الآن.</p>
    }
</div>

@section Scripts {
    <script>
        /*
            بحث تلقائي في سجلات الحضور والغياب
        */
        const searchInput = document.getElementById("attendanceSearchInput");
        const rows = document.querySelectorAll(".attendance-row");
        const noResultsMessage = document.getElementById("noResultsMessage");
        const searchResultText = document.getElementById("searchResultText");

        searchInput.addEventListener("input", function () {
            const searchValue = this.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(function (row) {
                const rowText = row.getAttribute("data-search");

                if (rowText.includes(searchValue)) {
                    row.style.display = "";
                    visibleCount++;

                    row.querySelector(".row-number").textContent = visibleCount;
                } else {
                    row.style.display = "none";
                }
            });

            noResultsMessage.style.display = visibleCount === 0 ? "block" : "none";

            searchResultText.textContent =
                searchValue === ""
                    ? "يتم عرض جميع سجلات الحضور والغياب."
                    : "عدد النتائج المطابقة: " + visibleCount;
        });
    </script>
}