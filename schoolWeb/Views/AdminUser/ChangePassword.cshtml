@model schoolWeb.ViewModels.UserManagement.ChangeUserPasswordViewModel

@{
    ViewData["Title"] = "تغيير كلمة المرور";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>تغيير كلمة المرور</h2>
    <p>يمكنك من هنا إعادة تعيين كلمة مرور المستخدم.</p>
</div>

<div class="page-box">
    <div asp-validation-summary="All" class="error-message"></div>

    <form asp-action="ChangePassword" method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="FullName" />
        <input type="hidden" asp-for="Username" />

        <div class="form-group">
            <label>اسم المستخدم</label>
            <input value="@Model.Username" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label>الاسم الكامل</label>
            <input value="@Model.FullName" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="NewPassword">كلمة المرور الجديدة</label>
            <input asp-for="NewPassword"
                   type="password"
                   class="form-control"
                   placeholder="أدخل كلمة المرور الجديدة" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmNewPassword">تأكيد كلمة المرور</label>
            <input asp-for="ConfirmNewPassword"
                   type="password"
                   class="form-control"
                   placeholder="أعد كتابة كلمة المرور الجديدة" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
        </div>

        <div style="margin-top:20px;">
            <button type="submit"
                    class="btn-primary-custom"
                    style="width:auto; padding:12px 24px;">
                حفظ كلمة المرور
            </button>

            <a asp-controller="AdminUser"
               asp-action="Index"
               class="btn-secondary-custom">
                رجوع
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}