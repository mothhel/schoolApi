@model List<schoolWeb.ViewModels.StudentNote.StudentNoteViewModel>

@{
    ViewData["Title"] = "ملاحظات الطلاب";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>ملاحظات الطلاب</h2>
    <p>عرض ملاحظات الطلاب، البحث، الإضافة، التعديل، والحذف.</p>
</div>

<div class="page-box" style="margin-bottom:25px;">
    @if (TempData["Success"] != null)
    {
        <div class="success-message">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error-message">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="error-message">@ViewBag.Error</div>
    }

    <a asp-controller="AdminStudentNote"
       asp-action="Create"
       class="btn-primary-custom"
       style="width:auto; padding:12px 24px; display:inline-block;">
        إضافة ملاحظة جديدة
    </a>
</div>

<div class="page-box" style="margin-bottom:25px;">
    <h3 style="margin-top:0;">البحث في الملاحظات</h3>

    <input id="noteSearchInput"
           class="form-control"
           placeholder="ابحث باسم الطالب أو رقمه أو نص الملاحظة" />
</div>

<div class="page-box">
    <h3 style="margin-top:0;">قائمة الملاحظات</h3>

    @if (Model != null && Model.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>م</th>
                    <th>اسم الطالب</th>
                    <th>رقم الطالب</th>
                    <th>الملاحظة</th>
                    <th>تاريخ الإضافة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int counter = 1;
                }

                @foreach (var item in Model)
                {
                    <tr class="note-row"
                        data-search="@($"{item.StudentName} {item.StudentNumber} {item.NoteText}".ToLower())">
                        <td class="row-number">@counter</td>
                        <td>@item.StudentName</td>
                        <td>@item.StudentNumber</td>
                        <td>@item.NoteText</td>
                        <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>

                        <td class="actions-cell">
                            <a asp-controller="AdminStudentNote"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-warning-custom">
                                تعديل
                            </a>

                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit"
                                        class="btn-danger-custom"
                                        onclick="return confirm('هل أنت متأكد من حذف هذه الملاحظة؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>

                    counter++;
                }
            </tbody>
        </table>

        <p id="noResultsMessage" style="display:none; margin-top:15px;">
            لا توجد ملاحظات مطابقة للبحث.
        </p>
    }
    else
    {
        <p>لا توجد ملاحظات مضافة حتى الآن.</p>
    }
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById("noteSearchInput");
        const rows = document.querySelectorAll(".note-row");
        const noResultsMessage = document.getElementById("noResultsMessage");

        searchInput.addEventListener("input", function () {
            const searchValue = this.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(function (row) {
                const text = row.getAttribute("data-search");

                if (text.includes(searchValue)) {
                    row.style.display = "";
                    visibleCount++;
                    row.querySelector(".row-number").textContent = visibleCount;
                } else {
                    row.style.display = "none";
                }
            });

            if (noResultsMessage) {
                noResultsMessage.style.display = visibleCount === 0 ? "block" : "none";
            }
        });
    </script>
}