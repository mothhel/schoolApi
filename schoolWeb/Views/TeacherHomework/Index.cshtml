@model List<schoolWeb.ViewModels.TeacherPortal.TeacherHomeworkViewModel>

@{
    ViewData["Title"] = "واجباتي";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*
    هذه الصفحة تعرض واجبات المدرس فقط

    المدرس يمكنه:
    - عرض واجباته
    - إضافة واجب
    - تعديل واجب
    - حذف واجب

    ولا تظهر له واجبات مدرس آخر.
*@

<div class="dashboard-header">
    <h2>واجباتي</h2>
    <p>إدارة الواجبات الخاصة بالمواد والصفوف والشعب المكلف بها.</p>
</div>

<div class="page-box" style="margin-bottom:25px;">
    @if (TempData["Success"] != null)
    {
        <div class="success-message">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error-message">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="error-message">@ViewBag.Error</div>
    }

    <a asp-controller="TeacherHomework"
       asp-action="Create"
       class="btn-primary-custom"
       style="width:auto; padding:12px 24px; display:inline-block;">
        إضافة واجب جديد
    </a>
</div>

<div class="page-box" style="margin-bottom:25px;">
    <h3 style="margin-top:0;">البحث في الواجبات</h3>

    <input id="homeworkSearchInput"
           class="form-control"
           placeholder="ابحث بعنوان الواجب أو المادة أو الصف أو الشعبة" />
</div>

<div class="page-box">
    <h3 style="margin-top:0;">قائمة الواجبات</h3>

    @if (Model != null && Model.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>م</th>
                    <th>عنوان الواجب</th>
                    <th>المادة</th>
                    <th>الصف</th>
                    <th>الشعبة</th>
                    <th>تاريخ التسليم</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int counter = 1;
                }

                @foreach (var item in Model)
                {
                    <tr class="homework-row"
                        data-search="@($"{item.Title} {item.SubjectName} {item.ClassRoomName} {item.SectionName}".ToLower())">
                        <td class="row-number">@counter</td>
                        <td>@item.Title</td>
                        <td>@item.SubjectName</td>
                        <td>@item.ClassRoomName</td>
                        <td>@item.SectionName</td>
                        <td>@item.DueDate.ToString("yyyy-MM-dd")</td>

                        <td class="actions-cell">
                            <a asp-controller="TeacherHomework"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-warning-custom">
                                تعديل
                            </a>

                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit"
                                        class="btn-danger-custom"
                                        onclick="return confirm('هل أنت متأكد من حذف هذا الواجب؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>

                    counter++;
                }
            </tbody>
        </table>

        <p id="noResultsMessage" style="display:none; margin-top:15px;">
            لا توجد واجبات مطابقة للبحث.
        </p>
    }
    else
    {
        <p>لا توجد واجبات مضافة حتى الآن.</p>
    }
</div>

@section Scripts {
    <script>
        /*
            بحث مباشر داخل جدول الواجبات
        */
        const searchInput = document.getElementById("homeworkSearchInput");
        const rows = document.querySelectorAll(".homework-row");
        const noResultsMessage = document.getElementById("noResultsMessage");

        if (searchInput) {
            searchInput.addEventListener("input", function () {
                const searchValue = this.value.trim().toLowerCase();
                let visibleCount = 0;

                rows.forEach(function (row) {
                    const text = row.getAttribute("data-search");

                    if (text.includes(searchValue)) {
                        row.style.display = "";
                        visibleCount++;
                        row.querySelector(".row-number").textContent = visibleCount;
                    } else {
                        row.style.display = "none";
                    }
                });

                if (noResultsMessage) {
                    noResultsMessage.style.display = visibleCount === 0 ? "block" : "none";
                }
            });
        }
    </script>
}