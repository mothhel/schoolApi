@using Microsoft.AspNetCore.Mvc.Rendering
@model List<schoolWeb.ViewModels.StudentPortal.StudentGradeViewModel>

@{
    ViewData["Title"] = "درجاتي";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var classRoomOptions = ViewBag.ClassRoomOptions as List<SelectListItem> ?? new List<SelectListItem>();
    var gradeTypeOptions = ViewBag.GradeTypeOptions as List<SelectListItem> ?? new List<SelectListItem>();

    var selectedClassRoomName = ViewBag.SelectedClassRoomName as string ?? "";
    var selectedGradeType = ViewBag.SelectedGradeType as string ?? "";
}

@functions {
    /*
        عرض الرقم بدون .00
    */
    string FormatNumber(decimal value)
    {
        return value.ToString("0.##");
    }
}

<div class="dashboard-header">
    <h2>درجاتي</h2>
    <p>اختر الصف أولًا، ثم اختر المحصلة لعرض الدرجات.</p>
</div>

<style>
    .student-grade-wrapper {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .student-info-card,
    .grade-panel,
    .filter-panel {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
    }

    .student-info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-top: 15px;
    }

    .info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 16px;
        font-weight: bold;
        color: #1e293b;
    }

        .info-box span {
            display: block;
            color: #64748b;
            font-size: 13px;
            margin-bottom: 6px;
        }

    .filter-grid {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 15px;
        align-items: end;
    }

    .grade-search-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .subject-badge {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        font-weight: bold;
        font-size: 13px;
    }

    .teacher-badge {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 999px;
        background: #f5f3ff;
        color: #6d28d9;
        font-weight: bold;
        font-size: 13px;
    }

    .score-badge {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 999px;
        background: #ecfdf5;
        color: #166534;
        font-weight: bold;
        font-size: 13px;
    }

    .total-box {
        margin-top: 20px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 18px;
        text-align: center;
        font-weight: bold;
        color: #1e293b;
        font-size: 18px;
    }

    .hint-box {
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #92400e;
        border-radius: 16px;
        padding: 18px;
        font-weight: bold;
    }

    @@media (max-width: 900px) {
        .student-info-grid,
        .filter-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@if (ViewBag.Error != null)
{
    <div class="error-message" style="margin-bottom:20px;">
        @ViewBag.Error
    </div>
}

<div class="student-grade-wrapper">

    <div class="student-info-card">
        <h3 style="margin-top:0;">بيانات الطالب</h3>

        <div class="student-info-grid">
            <div class="info-box">
                <span>اسم الطالب</span>
                @(ViewBag.StudentName ?? "غير متوفر")
            </div>

            <div class="info-box">
                <span>الصف الحالي</span>
                @(ViewBag.ClassRoomName ?? "غير متوفر")
            </div>

            <div class="info-box">
                <span>الشعبة</span>
                @(ViewBag.SectionName ?? "غير متوفر")
            </div>
        </div>
    </div>

    <div class="filter-panel">
        <h3 style="margin-top:0;">اختيار عرض الدرجات</h3>

        <form asp-action="Index" method="get">
            <div class="filter-grid">
                <div class="form-group">
                    <label>الصف</label>
                    <select name="selectedClassRoomName"
                            class="form-control"
                            asp-items="classRoomOptions">
                        <option value="">-- اختر الصف --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>المحصلة</label>
                    <select name="selectedGradeType"
                            class="form-control"
                            asp-items="gradeTypeOptions">
                        <option value="">-- اختر المحصلة --</option>
                    </select>
                </div>

                <button type="submit"
                        class="btn-primary-custom"
                        style="width:auto; padding:12px 24px;">
                    عرض
                </button>
            </div>
        </form>
    </div>

    <div class="grade-panel">
        @if (string.IsNullOrWhiteSpace(selectedClassRoomName) ||
        string.IsNullOrWhiteSpace(selectedGradeType))
        {
            <div class="hint-box">
                يرجى اختيار الصف أولًا، ثم اختيار المحصلة لعرض الدرجات.
            </div>
        }
        else
        {
            <h3 style="margin-top:0;">
                @selectedGradeType - @selectedClassRoomName
            </h3>

            <div class="grade-search-box">
                <input id="gradeSearchInput"
                       class="form-control"
                       placeholder="ابحث باسم المادة أو المدرس" />
            </div>

            @if (Model != null && Model.Any())
            {
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>م</th>
                            <th>المادة</th>
                            <th>المدرس</th>
                            <th>الدرجة</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int counter = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr class="grade-row"
                                data-search="@($"{item.SubjectName} {item.TeacherName}".ToLower())">
                                <td class="row-number">@counter</td>

                                <td>
                                    <span class="subject-badge">
                                        @item.SubjectName
                                    </span>
                                </td>

                                <td>
                                    <span class="teacher-badge">
                                        @(string.IsNullOrWhiteSpace(item.TeacherName) ? "-" : item.TeacherName)
                                    </span>
                                </td>

                                <td>
                                    <span class="score-badge">
                                        @FormatNumber(item.Score) / @FormatNumber(item.MaxScore)
                                    </span>
                                </td>
                            </tr>

                            counter++;
                        }
                    </tbody>
                </table>

                // <div class="total-box">
                //     المجموع:
                //     @FormatNumber(Model.Sum(g => g.Score))
                //     /
                //     @FormatNumber(Model.Sum(g => g.MaxScore))
                // </div>

                <p id="noResultsMessage" style="display:none; margin-top:15px;">
                    لا توجد مواد مطابقة للبحث.
                </p>
            }
            else
            {
                <p>لا توجد درجات متاحة لهذا الاختيار حتى الآن.</p>
            }
        }
    </div>

    <div>
        <a asp-controller="Student" asp-action="Index" class="btn-secondary-custom">
            رجوع إلى لوحة الطالب
        </a>
    </div>

</div>

@section Scripts {
    <script>
        const gradeSearchInput = document.getElementById("gradeSearchInput");
        const rows = document.querySelectorAll(".grade-row");
        const noResultsMessage = document.getElementById("noResultsMessage");

        if (gradeSearchInput) {
            gradeSearchInput.addEventListener("input", function () {
                const searchValue = this.value.trim().toLowerCase();
                let visibleCount = 0;

                rows.forEach(function (row) {
                    const text = row.getAttribute("data-search");

                    if (text.includes(searchValue)) {
                        row.style.display = "";
                        visibleCount++;
                        row.querySelector(".row-number").textContent = visibleCount;
                    } else {
                        row.style.display = "none";
                    }
                });

                if (noResultsMessage) {
                    noResultsMessage.style.display = visibleCount === 0 ? "block" : "none";
                }
            });
        }
    </script>
}