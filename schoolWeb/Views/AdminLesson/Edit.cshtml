@model schoolWeb.ViewModels.Lesson.UpdateLessonViewModel

@*
    هذه الصفحة مسؤولة عن تعديل بيانات الدرس
*@

@{
    ViewData["Title"] = "تعديل درس";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>تعديل الدرس</h2>
    <p>يمكنك من هنا تعديل التكليف المرتبط بالدرس وبيانات الدرس.</p>
</div>

<div class="page-box">
    <div asp-validation-summary="All" class="error-message"></div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="TeacherAssignmentId">التكليف التدريسي</label>

            <select asp-for="TeacherAssignmentId"
                    asp-items="Model.TeacherAssignments"
                    class="form-control">
                <option value="">-- اختر التكليف التدريسي --</option>
            </select>

            <span asp-validation-for="TeacherAssignmentId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Title">عنوان الدرس</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">وصف الدرس</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="LessonDate">تاريخ الدرس</label>
            <input asp-for="LessonDate" type="date" class="form-control" />
            <span asp-validation-for="LessonDate" class="text-danger"></span>
        </div>

        <div style="margin-top:20px;">
            <button type="submit" class="btn-primary-custom" style="width:auto; padding:12px 24px;">
                حفظ التعديل
            </button>

            <a asp-controller="AdminLesson" asp-action="Index" class="btn-secondary-custom">
                رجوع
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}