@model schoolWeb.ViewModels.Grade.UpdateGradeViewModel

@{
    ViewData["Title"] = "تعديل الدرجة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>تعديل الدرجة</h2>
    <p>يمكنك تعديل درجات الطالب لهذه المادة والفترة بدون تغيير بيانات الربط الأساسية.</p>
</div>

<style>
    .edit-grade-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 25px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        margin-bottom: 25px;
    }

    .grade-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 18px;
        margin-bottom: 25px;
    }

    .score-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        align-items: end;
    }

    .readonly-input {
        background: #eef2ff !important;
        font-weight: bold;
        color: #1e293b;
    }

    .total-box {
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 12px;
        font-weight: bold;
        color: #166534;
        text-align: center;
    }

    .edit-actions {
        margin-top: 25px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
</style>

<div class="edit-grade-card">

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="error-message"></div>
    }

    <form asp-action="Edit" method="post">
        @* مهم جدًا: هذه القيم ترجع للكنترولر حتى يتم التعديل بدون أخطاء *@
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="StudentNumber" />
        <input type="hidden" asp-for="SubjectName" />
        <input type="hidden" asp-for="ClassRoomName" />
        <input type="hidden" asp-for="SectionName" />
        <input type="hidden" asp-for="TermName" />

        <h3 style="margin-top:0;">بيانات الدرجة</h3>

        <div class="grade-info-grid">
            <div class="form-group">
                <label>رقم الطالب</label>
                <input value="@Model.StudentNumber" class="form-control readonly-input" readonly />
            </div>

            <div class="form-group">
                <label>المادة</label>
                <input value="@Model.SubjectName" class="form-control readonly-input" readonly />
            </div>

            <div class="form-group">
                <label>الصف</label>
                <input value="@Model.ClassRoomName" class="form-control readonly-input" readonly />
            </div>

            <div class="form-group">
                <label>الشعبة</label>
                <input value="@Model.SectionName" class="form-control readonly-input" readonly />
            </div>

            <div class="form-group">
                <label>الفترة</label>
                <input value="@Model.TermName" class="form-control readonly-input" readonly />
            </div>
        </div>

        @if (Model.TermName == "نصف العام")
        {
            <h3>درجات نصف العام</h3>

            <div class="score-grid">
                <div class="form-group">
                    <label asp-for="FirstAssessmentScore">المحصلة الأولى /20</label>
                    <input asp-for="FirstAssessmentScore"
                           type="number"
                           min="0"
                           max="20"
                           step="0.5"
                           class="form-control score-input"
                           id="assessmentScore" />
                    <span asp-validation-for="FirstAssessmentScore" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MidtermExamScore">اختبار نصف العام /30</label>
                    <input asp-for="MidtermExamScore"
                           type="number"
                           min="0"
                           max="30"
                           step="0.5"
                           class="form-control score-input"
                           id="examScore" />
                    <span asp-validation-for="MidtermExamScore" class="text-danger"></span>
                </div>

                <div>
                    <label>المجموع /50</label>
                    <div class="total-box" id="totalBox">0 / 50</div>
                </div>
            </div>

            @* هذه ترسل فارغة حتى لا تسبب مشكلة في الربط *@
            <input type="hidden" asp-for="SecondAssessmentScore" />
            <input type="hidden" asp-for="FinalExamScore" />
        }
        else if (Model.TermName == "نهاية العام")
        {
            <h3>درجات نهاية العام</h3>

            <div class="score-grid">
                <div class="form-group">
                    <label asp-for="SecondAssessmentScore">المحصلة الثانية /20</label>
                    <input asp-for="SecondAssessmentScore"
                           type="number"
                           min="0"
                           max="20"
                           step="0.5"
                           class="form-control score-input"
                           id="assessmentScore" />
                    <span asp-validation-for="SecondAssessmentScore" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FinalExamScore">اختبار نهاية العام /30</label>
                    <input asp-for="FinalExamScore"
                           type="number"
                           min="0"
                           max="30"
                           step="0.5"
                           class="form-control score-input"
                           id="examScore" />
                    <span asp-validation-for="FinalExamScore" class="text-danger"></span>
                </div>

                <div>
                    <label>المجموع /50</label>
                    <div class="total-box" id="totalBox">0 / 50</div>
                </div>
            </div>

            @* هذه ترسل فارغة حتى لا تسبب مشكلة في الربط *@
            <input type="hidden" asp-for="FirstAssessmentScore" />
            <input type="hidden" asp-for="MidtermExamScore" />
        }
        else
        {
            <div class="error-message">
                نوع الفترة غير معروف. الرجاء الرجوع إلى صفحة الدرجات.
            </div>
        }

        <div class="edit-actions">
            <button type="submit" class="btn-primary-custom" style="width:auto; padding:12px 24px;">
                حفظ التعديل
            </button>

            <a asp-controller="AdminGrade" asp-action="Index" class="btn-secondary-custom">
                رجوع
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const assessmentInput = document.getElementById("assessmentScore");
        const examInput = document.getElementById("examScore");
        const totalBox = document.getElementById("totalBox");

        function calculateTotal() {
            const assessment = parseFloat(assessmentInput?.value) || 0;
            const exam = parseFloat(examInput?.value) || 0;
            const total = assessment + exam;

            totalBox.textContent = total + " / 50";

            if (assessment > 20 || exam > 30 || total > 50) {
                totalBox.style.background = "#fef2f2";
                totalBox.style.borderColor = "#fecaca";
                totalBox.style.color = "#991b1b";
            } else {
                totalBox.style.background = "#ecfdf5";
                totalBox.style.borderColor = "#bbf7d0";
                totalBox.style.color = "#166534";
            }
        }

        if (assessmentInput && examInput) {
            assessmentInput.addEventListener("input", calculateTotal);
            examInput.addEventListener("input", calculateTotal);
            calculateTotal();
        }
    </script>
}