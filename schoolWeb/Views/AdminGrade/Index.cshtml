@model List<schoolWeb.ViewModels.Grade.GradeGroupViewModel>

@{
    ViewData["Title"] = "إدارة الدرجات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>إدارة الدرجات</h2>
    <p>عرض درجات الطلاب بشكل مجمع حسب المادة والفترة.</p>
</div>


@if (TempData["Success"] != null)
{
    <div class="success-message" style="margin-bottom:20px;">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="error-message" style="margin-bottom:20px;">
        @TempData["Error"]
    </div>
}

<div class="cards-grid" style="margin-bottom:25px;">
    <a asp-controller="AdminGrade" asp-action="CreateMidYear" class="dashboard-card">
        <h3>إدخال درجات نصف العام</h3>
        <p>المحصلة الأولى /20 واختبار نصف العام /30.</p>
    </a>

    <a asp-controller="AdminGrade" asp-action="CreateFinalYear" class="dashboard-card">
        <h3>إدخال درجات نهاية العام</h3>
        <p>المحصلة الثانية /20 واختبار نهاية العام /30.</p>
    </a>
</div>

<div class="page-box" style="margin-bottom:25px;">
    <h3 style="margin-top:0;">البحث عن نتيجة</h3>

    <input id="gradeSearchInput"
           class="form-control"
           placeholder="ابحثي باسم الطالب أو رقمه أو المادة أو الصف أو الشعبة" />
</div>

<div class="page-box">
    <h3 style="margin-top:0;">الدرجات المدخلة</h3>

    @if (Model != null && Model.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>م</th>
                    <th>الطالب</th>
                    <th>رقم الطالب</th>
                    <th>المادة</th>
                    <th>الصف</th>
                    <th>الشعبة</th>
                    <th>الفترة</th>
                    <th>المحصلة</th>
                    <th>الاختبار</th>
                    <th>المجموع</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int counter = 1;
                }

                @foreach (var item in Model)
                {
                    <tr class="grade-row"
                        data-search="@($"{item.StudentName} {item.StudentNumber} {item.SubjectName} {item.ClassRoomName} {item.SectionName} {item.TermName}".ToLower())">

                        <td class="row-number">@counter</td>
                        <td>@item.StudentName</td>
                        <td>@item.StudentNumber</td>
                        <td>@item.SubjectName</td>
                        <td>@item.ClassRoomName</td>
                        <td>@item.SectionName</td>
                        <td>@item.TermName</td>

                        @if (item.TermName == "نصف العام")
                        {
                            <td>@item.AssessmentScore / 20</td>
                            <td>@item.ExamScore / 30</td>
                            <td>@item.Total / 50</td>
                        }
                        else
                        {
                            <td>@item.AssessmentScore / 20</td>
                            <td>@item.ExamScore / 30</td>
                            <td>@item.Total / 50</td>
                        }

                        <td class="actions-cell">
                            <a asp-controller="AdminGrade"
                               asp-action="Edit"
                               asp-route-id="@item.FirstGradeId"
                               class="btn-warning-custom">
                                تعديل
                            </a>

                            <form asp-action="DeleteGroup" method="post" style="display:inline;">
                                <input type="hidden" name="firstGradeId" value="@item.FirstGradeId" />
                                <input type="hidden" name="examGradeId" value="@item.ExamGradeId" />

                                <button type="submit"
                                        class="btn-danger-custom"
                                        onclick="return confirm('هل أنت متأكد من حذف درجات هذه المادة لهذه الفترة؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>

                    counter++;
                }
            </tbody>
        </table>

        <p id="noResultsMessage" style="display:none; margin-top:15px;">
            لا توجد نتائج مطابقة للبحث.
        </p>
    }
    else
    {
        <p>لا توجد درجات مدخلة حتى الآن.</p>
    }
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById("gradeSearchInput");
        const rows = document.querySelectorAll(".grade-row");
        const noResultsMessage = document.getElementById("noResultsMessage");

        searchInput.addEventListener("input", function () {
            const searchValue = this.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(function (row) {
                const text = row.getAttribute("data-search");

                if (text.includes(searchValue)) {
                    row.style.display = "";
                    visibleCount++;
                    row.querySelector(".row-number").textContent = visibleCount;
                } else {
                    row.style.display = "none";
                }
            });

            if (noResultsMessage) {
                noResultsMessage.style.display = visibleCount === 0 ? "block" : "none";
            }
        });
    </script>
}