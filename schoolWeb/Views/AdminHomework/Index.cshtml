@model List<schoolWeb.ViewModels.Homework.HomeworkViewModel>

@*
    هذه الصفحة مسؤولة عن:
    - عرض جميع الواجبات
    - البحث التلقائي عن واجب
    - إضافة واجب جديد
    - تعديل واجب
    - حذف واجب
*@

@{
    ViewData["Title"] = "إدارة الواجبات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>إدارة الواجبات</h2>
    <p>من هنا يمكنك عرض الواجبات المرتبطة بالتكليفات التدريسية وإضافة أو تعديل أو حذف واجب.</p>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    @if (TempData["Success"] != null)
    {
        <div class="success-message">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error-message">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="error-message">@ViewBag.Error</div>
    }

    <a asp-controller="AdminHomework"
       asp-action="Create"
       class="btn-primary-custom"
       style="width:auto; padding:12px 24px; display:inline-block;">
        إضافة واجب جديد
    </a>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    <h3 style="margin-top:0;">البحث عن واجب</h3>

    <div class="form-group">
        <label>بحث بعنوان الواجب أو المدرس أو المادة أو الصف أو الشعبة</label>
        <input id="homeworkSearchInput"
               class="form-control"
               placeholder="مثال: واجب الجمع أو رياضيات أو أحمد أو الصف 1" />
    </div>

    <p id="searchResultText" style="margin-top:10px; color:#64748b;">
        يتم عرض جميع الواجبات.
    </p>
</div>

<div class="page-box">
    <h3 style="margin-top:0;">قائمة الواجبات</h3>

    @if (Model != null && Model.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>م</th>
                    <th>عنوان الواجب</th>
                    <th>المدرس</th>
                    <th>المادة</th>
                    <th>الصف</th>
                    <th>الشعبة</th>
                    <th>تاريخ التسليم</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int counter = 1;
                }

                @foreach (var item in Model)
                {
                    <tr class="homework-row"
                        data-search="@($"{item.Title} {item.TeacherName} {item.SubjectName} {item.ClassRoomName} {item.SectionName}".ToLower())">
                        <td class="row-number">@counter</td>
                        <td>@item.Title</td>
                        <td>@item.TeacherName</td>
                        <td>@item.SubjectName</td>
                        <td>@item.ClassRoomName</td>
                        <td>@item.SectionName</td>
                        <td>@item.DueDate.ToString("yyyy-MM-dd")</td>

                        <td class="actions-cell">
                            <a asp-controller="AdminHomework"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-warning-custom">
                                تعديل
                            </a>

                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit"
                                        class="btn-danger-custom"
                                        onclick="return confirm('هل أنت متأكد من حذف هذا الواجب؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>

                    counter++;
                }
            </tbody>
        </table>

        <p id="noResultsMessage" style="display:none; margin-top:15px;">
            لا توجد واجبات مطابقة للبحث.
        </p>
    }
    else
    {
        <p>لا توجد واجبات مضافة حتى الآن.</p>
    }
</div>

@section Scripts {
    <script>
        /*
            بحث تلقائي عن الواجبات
        */
        const searchInput = document.getElementById("homeworkSearchInput");
        const rows = document.querySelectorAll(".homework-row");
        const noResultsMessage = document.getElementById("noResultsMessage");
        const searchResultText = document.getElementById("searchResultText");

        searchInput.addEventListener("input", function () {
            const searchValue = this.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(function (row) {
                const rowText = row.getAttribute("data-search");

                if (rowText.includes(searchValue)) {
                    row.style.display = "";
                    visibleCount++;

                    row.querySelector(".row-number").textContent = visibleCount;
                } else {
                    row.style.display = "none";
                }
            });

            noResultsMessage.style.display = visibleCount === 0 ? "block" : "none";

            searchResultText.textContent =
                searchValue === ""
                    ? "يتم عرض جميع الواجبات."
                    : "عدد النتائج المطابقة: " + visibleCount;
        });
    </script>
}