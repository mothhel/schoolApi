@model List<schoolWeb.ViewModels.Teacher.TeacherViewModel>

@*
    هذه الصفحة مسؤولة عن:
    - عرض المدرسين
    - البحث التلقائي
    - الانتقال لإضافة مدرس
    - حذف مدرس
*@

@{
    ViewData["Title"] = "إدارة المدرسين";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>إدارة المدرسين</h2>
    <p>من هنا يمكنك عرض المدرسين، البحث عن مدرس، إضافة مدرس جديد، أو حذف مدرس.</p>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    @if (TempData["Success"] != null)
    {
        <div class="success-message">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error-message">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="error-message">@ViewBag.Error</div>
    }

    <a asp-controller="AdminTeacher"
       asp-action="Create"
       class="btn-primary-custom"
       style="width:auto; padding:12px 24px; display:inline-block;">
        إضافة مدرس جديد
    </a>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    <h3 style="margin-top:0;">البحث عن مدرس</h3>

    <div class="form-group">
        <label>بحث بالاسم أو رقم المدرس أو اسم المستخدم أو التخصص</label>
        <input id="teacherSearchInput"
               class="form-control"
               placeholder="مثال: أحمد أو T1001 أو teacher1 أو رياضيات" />
    </div>

    <p id="searchResultText" style="margin-top:10px; color:#64748b;">
        يتم عرض جميع المدرسين.
    </p>
</div>

<div class="page-box">
    <h3 style="margin-top:0;">قائمة المدرسين</h3>

    @if (Model != null && Model.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>م</th>
                    <th>رقم المدرس</th>
                    <th>اسم المدرس</th>
                    <th>اسم المستخدم</th>
                    <th>التخصص</th>
                    <th>الهاتف</th>
                    <th>العنوان</th>
                    <th>تاريخ التوظيف</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int counter = 1;
                }

                @foreach (var item in Model)
                {
                    <tr class="teacher-row"
                        data-search="@($"{item.TeacherNumber} {item.FullName} {item.Username} {item.Specialty} {item.PhoneNumber} {item.Address}".ToLower())">
                        <td class="row-number">@counter</td>
                        <td>@item.TeacherNumber</td>
                        <td>@item.FullName</td>
                        <td>@item.Username</td>
                        <td>@item.Specialty</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Address</td>
                        <td>@(item.HireDate.HasValue ? item.HireDate.Value.ToString("yyyy-MM-dd") : "")</td>

                        <td class="actions-cell">
                            <a asp-controller="AdminTeacher"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-warning-custom">
                                تعديل
                            </a>

                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit"
                                        class="btn-danger-custom"
                                        onclick="return confirm('هل أنت متأكد من حذف هذا المدرس؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>

                    counter++;
                }
            </tbody>
        </table>

        <p id="noResultsMessage" style="display:none; margin-top:15px;">
            لا يوجد مدرسون مطابقون للبحث.
        </p>
    }
    else
    {
        <p>لا يوجد مدرسون مضافون حتى الآن.</p>
    }
</div>

@section Scripts {
    <script>
        /*
            بحث تلقائي عن المدرسين
        */
        const searchInput = document.getElementById("teacherSearchInput");
        const rows = document.querySelectorAll(".teacher-row");
        const noResultsMessage = document.getElementById("noResultsMessage");
        const searchResultText = document.getElementById("searchResultText");

        searchInput.addEventListener("input", function () {
            const searchValue = this.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(function (row) {
                const rowText = row.getAttribute("data-search");

                if (rowText.includes(searchValue)) {
                    row.style.display = "";
                    visibleCount++;

                    row.querySelector(".row-number").textContent = visibleCount;
                } else {
                    row.style.display = "none";
                }
            });

            noResultsMessage.style.display = visibleCount === 0 ? "block" : "none";

            searchResultText.textContent =
                searchValue === ""
                    ? "يتم عرض جميع المدرسين."
                    : "عدد النتائج المطابقة: " + visibleCount;
        });
    </script>
}