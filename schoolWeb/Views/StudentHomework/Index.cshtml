@model List<schoolWeb.ViewModels.StudentPortal.StudentHomeworkViewModel>

@{
    ViewData["Title"] = "واجباتي";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*
    هذه الصفحة تعرض الواجبات الخاصة بالطالب فقط

    الطالب لا يستطيع:
    - إضافة واجب
    - تعديل واجب
    - حذف واجب

    فقط يشاهد واجبات صفه وشعبته.

    ملاحظة مهمة:
    عند دخول الطالب إلى هذه الصفحة، يقوم StudentHomeworkController
    بتحديث حالة المشاهدة للواجبات، لذلك يختفي عداد "واجباتي جديد"
    عند الرجوع إلى لوحة الطالب.
*@

<div class="dashboard-header">
    <h2>واجباتي</h2>
    <p>هنا يمكنك عرض الواجبات المطلوبة حسب صفك وشعبتك.</p>
</div>

<style>
    .student-homework-wrapper {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .student-info-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
    }

    .student-info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-top: 15px;
    }

    .info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 16px;
        font-weight: bold;
        color: #1e293b;
    }

        .info-box span {
            display: block;
            color: #64748b;
            font-size: 13px;
            margin-bottom: 6px;
        }

    .homework-panel {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
    }

    .homework-search-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .subject-badge {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        font-weight: bold;
        font-size: 13px;
    }

    .due-badge {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 999px;
        background: #ecfdf5;
        color: #166534;
        font-weight: bold;
        font-size: 13px;
    }

    .late-badge {
        background: #fef2f2;
        color: #991b1b;
    }

    .viewed-note {
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        color: #166534;
        border-radius: 16px;
        padding: 14px 18px;
        margin-bottom: 20px;
        font-weight: bold;
        line-height: 1.7;
    }

    .empty-box {
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #92400e;
        border-radius: 16px;
        padding: 16px;
        font-weight: bold;
    }

    @@media (max-width: 900px) {
        .student-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@if (ViewBag.Error != null)
{
    <div class="error-message" style="margin-bottom:20px;">
        @ViewBag.Error
    </div>
}

<div class="student-homework-wrapper">

    <div class="student-info-card">
        <h3 style="margin-top:0;">بيانات الطالب</h3>

        <div class="student-info-grid">
            <div class="info-box">
                <span>اسم الطالب</span>
                @(ViewBag.StudentName ?? "غير متوفر")
            </div>

            <div class="info-box">
                <span>الصف</span>
                @(ViewBag.ClassRoomName ?? "غير متوفر")
            </div>

            <div class="info-box">
                <span>الشعبة</span>
                @(ViewBag.SectionName ?? "غير متوفر")
            </div>
        </div>
    </div>

    <div class="homework-panel">
        <h3 style="margin-top:0;">قائمة الواجبات</h3>

        <div class="viewed-note">
            تم عرض الواجبات الخاصة بك. عند الرجوع إلى لوحة الطالب سيختفي عداد الواجبات الجديدة إذا لم توجد واجبات أحدث.
        </div>

        <div class="homework-search-box">
            <label>بحث في الواجبات</label>
            <input id="homeworkSearchInput"
                   class="form-control"
                   placeholder="ابحث بعنوان الواجب أو المادة أو المدرس" />
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>م</th>
                        <th>عنوان الواجب</th>
                        <th>الوصف</th>
                        <th>المادة</th>
                        <th>المدرس</th>
                        <th>تاريخ التسليم</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int counter = 1;
                    }

                    @foreach (var item in Model)
                    {
                        var isLate = item.DueDate.Date < DateTime.Today;
                        var searchText = $"{item.Title} {item.Description} {item.SubjectName} {item.TeacherName}".ToLower();

                        <tr class="homework-row" data-search="@searchText">
                            <td class="row-number">@counter</td>

                            <td>@(string.IsNullOrWhiteSpace(item.Title) ? "-" : item.Title)</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                            </td>

                            <td>
                                <span class="subject-badge">
                                    @(string.IsNullOrWhiteSpace(item.SubjectName) ? "-" : item.SubjectName)
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.TeacherName) ? "-" : item.TeacherName)
                            </td>

                            <td>
                                <span class="due-badge @(isLate ? "late-badge" : "")">
                                    @item.DueDate.ToString("yyyy-MM-dd")
                                </span>
                            </td>
                        </tr>

                        counter++;
                    }
                </tbody>
            </table>

            <p id="noResultsMessage" style="display:none; margin-top:15px;">
                لا توجد واجبات مطابقة للبحث.
            </p>
        }
        else
        {
            <div class="empty-box">
                لا توجد واجبات متاحة لصفك وشعبتك حتى الآن.
            </div>
        }
    </div>

    <div>
        <a asp-controller="Student" asp-action="Index" class="btn-secondary-custom">
            رجوع إلى لوحة الطالب
        </a>
    </div>

</div>

@section Scripts {
    <script>
        /*
            بحث مباشر داخل جدول الواجبات
        */
        const homeworkSearchInput = document.getElementById("homeworkSearchInput");
        const rows = document.querySelectorAll(".homework-row");
        const noResultsMessage = document.getElementById("noResultsMessage");

        if (homeworkSearchInput) {
            homeworkSearchInput.addEventListener("input", function () {
                const searchValue = this.value.trim().toLowerCase();
                let visibleCount = 0;

                rows.forEach(function (row) {
                    const text = row.getAttribute("data-search") || "";

                    if (text.includes(searchValue)) {
                        row.style.display = "";
                        visibleCount++;

                        const rowNumber = row.querySelector(".row-number");
                        if (rowNumber) {
                            rowNumber.textContent = visibleCount;
                        }
                    } else {
                        row.style.display = "none";
                    }
                });

                if (noResultsMessage) {
                    noResultsMessage.style.display = visibleCount === 0 && rows.length > 0 ? "block" : "none";
                }
            });
        }
    </script>
}