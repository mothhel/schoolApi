@model List<schoolWeb.ViewModels.Subject.SubjectViewModel>

@*
    هذه الصفحة مسؤولة عن:
    - عرض المواد الدراسية
    - البحث التلقائي عن مادة
    - الانتقال لإضافة مادة
    - تعديل مادة
    - حذف مادة
*@

@{
    ViewData["Title"] = "إدارة المواد";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-header">
    <h2>إدارة المواد</h2>
    <p>من هنا يمكنك عرض المواد الدراسية، إضافة مادة، تعديلها أو حذفها.</p>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    @if (TempData["Success"] != null)
    {
        <div class="success-message">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error-message">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="error-message">@ViewBag.Error</div>
    }

    <a asp-controller="AdminSubject"
       asp-action="Create"
       class="btn-primary-custom"
       style="width:auto; padding:12px 24px; display:inline-block;">
        إضافة مادة جديدة
    </a>
</div>

<div class="page-box" style="margin-bottom: 25px;">
    <h3 style="margin-top:0;">البحث عن مادة</h3>

    <div class="form-group">
        <label>بحث باسم المادة</label>
        <input id="subjectSearchInput"
               class="form-control"
               placeholder="مثال: رياضيات أو علوم أو عربي" />
    </div>

    <p id="searchResultText" style="margin-top:10px; color:#64748b;">
        يتم عرض جميع المواد.
    </p>
</div>

<div class="page-box">
    <h3 style="margin-top:0;">قائمة المواد</h3>

    @if (Model != null && Model.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>م</th>
                    <th>اسم المادة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int counter = 1;
                }

                @foreach (var item in Model)
                {
                    <tr class="subject-row"
                        data-search="@item.Name.ToLower()">
                        <td class="row-number">@counter</td>
                        <td>@item.Name</td>

                        <td class="actions-cell">
                            <a asp-controller="AdminSubject"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-warning-custom">
                                تعديل
                            </a>

                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit"
                                        class="btn-danger-custom"
                                        onclick="return confirm('هل أنت متأكد من حذف هذه المادة؟');">
                                    حذف
                                </button>
                            </form>
                        </td>
                    </tr>

                    counter++;
                }
            </tbody>
        </table>

        <p id="noResultsMessage" style="display:none; margin-top:15px;">
            لا توجد مواد مطابقة للبحث.
        </p>
    }
    else
    {
        <p>لا توجد مواد مضافة حتى الآن.</p>
    }
</div>

@section Scripts {
    <script>
        /*
            بحث تلقائي عن المواد
        */
        const searchInput = document.getElementById("subjectSearchInput");
        const rows = document.querySelectorAll(".subject-row");
        const noResultsMessage = document.getElementById("noResultsMessage");
        const searchResultText = document.getElementById("searchResultText");

        searchInput.addEventListener("input", function () {
            const searchValue = this.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(function (row) {
                const rowText = row.getAttribute("data-search");

                if (rowText.includes(searchValue)) {
                    row.style.display = "";
                    visibleCount++;

                    row.querySelector(".row-number").textContent = visibleCount;
                } else {
                    row.style.display = "none";
                }
            });

            noResultsMessage.style.display = visibleCount === 0 ? "block" : "none";

            searchResultText.textContent =
                searchValue === ""
                    ? "يتم عرض جميع المواد."
                    : "عدد النتائج المطابقة: " + visibleCount;
        });
    </script>
}