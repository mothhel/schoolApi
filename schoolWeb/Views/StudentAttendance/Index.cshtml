@model List<schoolWeb.ViewModels.StudentPortal.StudentAttendanceViewModel>

@{
    ViewData["Title"] = "حضوري وغيابي";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*
    هذه الصفحة تعرض سجل حضور وغياب الطالب فقط

    الطالب لا يستطيع:
    - إضافة
    - تعديل
    - حذف

    فقط يشاهد السجل.

    ملاحظة مهمة:
    عند دخول الطالب إلى هذه الصفحة، يقوم StudentAttendanceController
    بتحديث حالة المشاهدة للحضور والغياب، لذلك يختفي عداد "حضوري وغيابي جديد"
    عند الرجوع إلى لوحة الطالب.
*@

<div class="dashboard-header">
    <h2>حضوري وغيابي</h2>
    <p>هنا يمكنك عرض سجل حضورك وغيابك حسب المواد والتواريخ.</p>
</div>

<style>
    .student-attendance-wrapper {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .student-info-card,
    .attendance-panel {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
    }

    .student-info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-top: 15px;
    }

    .info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 16px;
        font-weight: bold;
        color: #1e293b;
    }

        .info-box span {
            display: block;
            color: #64748b;
            font-size: 13px;
            margin-bottom: 6px;
        }

    .attendance-search-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .status-badge {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 999px;
        font-weight: bold;
        font-size: 13px;
    }

    .status-present {
        background: #ecfdf5;
        color: #166534;
    }

    .status-absent {
        background: #fef2f2;
        color: #991b1b;
    }

    .status-excused {
        background: #fffbeb;
        color: #92400e;
    }

    .viewed-note {
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        color: #166534;
        border-radius: 16px;
        padding: 14px 18px;
        margin-bottom: 20px;
        font-weight: bold;
        line-height: 1.7;
    }

    .empty-box {
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #92400e;
        border-radius: 16px;
        padding: 16px;
        font-weight: bold;
    }

    @@media (max-width: 900px) {
        .student-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@if (ViewBag.Error != null)
{
    <div class="error-message" style="margin-bottom:20px;">
        @ViewBag.Error
    </div>
}

<div class="student-attendance-wrapper">

    <div class="student-info-card">
        <h3 style="margin-top:0;">بيانات الطالب</h3>

        <div class="student-info-grid">
            <div class="info-box">
                <span>اسم الطالب</span>
                @(ViewBag.StudentName ?? "غير متوفر")
            </div>

            <div class="info-box">
                <span>الصف</span>
                @(ViewBag.ClassRoomName ?? "غير متوفر")
            </div>

            <div class="info-box">
                <span>الشعبة</span>
                @(ViewBag.SectionName ?? "غير متوفر")
            </div>
        </div>
    </div>

    <div class="attendance-panel">
        <h3 style="margin-top:0;">سجل الحضور والغياب</h3>

        <div class="viewed-note">
            تم عرض سجل الحضور والغياب الخاص بك. عند الرجوع إلى لوحة الطالب سيختفي عداد الحضور والغياب الجديد إذا لم توجد سجلات أحدث.
        </div>

        <div class="attendance-search-box">
            <label>بحث في السجل</label>
            <input id="attendanceSearchInput"
                   class="form-control"
                   placeholder="ابحث بالمادة أو الحالة أو المدرس" />
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>م</th>
                        <th>التاريخ</th>
                        <th>المادة</th>
                        <th>المدرس</th>
                        <th>الحالة</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int counter = 1;
                    }

                    @foreach (var item in Model)
                    {
                        string statusText = string.IsNullOrWhiteSpace(item.Status) ? "-" : item.Status;
                        string statusClass = "status-present";

                        if (statusText == "غائب")
                        {
                            statusClass = "status-absent";
                        }
                        else if (statusText == "مستأذن")
                        {
                            statusClass = "status-excused";
                        }

                        var searchText = $"{item.SubjectName} {statusText} {item.TeacherName}".ToLower();

                        <tr class="attendance-row" data-search="@searchText">
                            <td class="row-number">@counter</td>

                            <td>@item.AttendanceDate.ToString("yyyy-MM-dd")</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.SubjectName) ? "-" : item.SubjectName)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.TeacherName) ? "-" : item.TeacherName)
                            </td>

                            <td>
                                <span class="status-badge @statusClass">
                                    @statusText
                                </span>
                            </td>
                        </tr>

                        counter++;
                    }
                </tbody>
            </table>

            <p id="noResultsMessage" style="display:none; margin-top:15px;">
                لا توجد سجلات مطابقة للبحث.
            </p>
        }
        else
        {
            <div class="empty-box">
                لا يوجد سجل حضور وغياب حتى الآن.
            </div>
        }
    </div>

    <div>
        <a asp-controller="Student" asp-action="Index" class="btn-secondary-custom">
            رجوع إلى لوحة الطالب
        </a>
    </div>

</div>

@section Scripts {
    <script>
        /*
            بحث مباشر داخل جدول الحضور والغياب
        */
        const attendanceSearchInput = document.getElementById("attendanceSearchInput");
        const rows = document.querySelectorAll(".attendance-row");
        const noResultsMessage = document.getElementById("noResultsMessage");

        if (attendanceSearchInput) {
            attendanceSearchInput.addEventListener("input", function () {
                const searchValue = this.value.trim().toLowerCase();
                let visibleCount = 0;

                rows.forEach(function (row) {
                    const text = row.getAttribute("data-search") || "";

                    if (text.includes(searchValue)) {
                        row.style.display = "";
                        visibleCount++;

                        const rowNumber = row.querySelector(".row-number");
                        if (rowNumber) {
                            rowNumber.textContent = visibleCount;
                        }
                    } else {
                        row.style.display = "none";
                    }
                });

                if (noResultsMessage) {
                    noResultsMessage.style.display = visibleCount === 0 && rows.length > 0 ? "block" : "none";
                }
            });
        }
    </script>
}